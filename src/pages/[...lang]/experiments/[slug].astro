---
import MainLayout from '../../../layouts/MainLayout.astro'
import CodeTabs from '../../../components/CodeTabs.astro'
import { experiments, type Experiment } from '../../../data/experiments'
import { ui } from '../../../i18n/ui'
import { getLangFromUrl, useTranslations } from '../../../i18n/utils'

export function getStaticPaths() {
  return Object.keys(ui).flatMap((lang) =>
    experiments.map((exp) => ({
      params: { lang, slug: exp.slug },
      props: { exp }
    }))
  )
}

const { exp } = Astro.props as { exp: Experiment }
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const Demo = exp.Demo

const idx = experiments.findIndex((e) => e.slug === exp.slug)
const prev = experiments[idx - 1]
const next = experiments[idx + 1]
---

<MainLayout title={`${exp.title} — David Huertas`} language={lang}>
  <article class='frame-stack'>
    <header class='frame-block reveal' style='--reveal-delay: 60ms'>
      <nav
        class='flex flex-wrap items-center gap-2 font-mono text-muted text-xs'
        aria-label='Breadcrumb'
      >
        <a href={`/${lang}/`} class='link-underline'>kuro</a>
        <span class='text-muted/40'>/</span>
        <a href={`/${lang}/experiments`} class='link-underline'>
          {t('section.experiments').toLowerCase()}
        </a>
        <span class='text-muted/40'>/</span>
        <span class='text-ink'>{exp.slug}</span>
      </nav>

      <h1
        class='mt-6 font-semibold text-ink text-3xl sm:text-4xl tracking-tight'
      >
        {exp.title}
      </h1>
      <p class='mt-3 text-[15px] text-ink/80 leading-7'>{exp.about}</p>

      {
        exp.tags.length > 0 && (
          <ul class='mt-4 flex flex-wrap gap-1.5'>
            {exp.tags.map((tag) => (
              <li class='border border-line px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wide text-muted'>
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <section
      class='frame-block reveal'
      style='--reveal-delay: 160ms'
      aria-labelledby='demo-heading'
    >
      <h2
        id='demo-heading'
        class='mb-3 font-mono text-muted text-xs uppercase tracking-[0.18em]'
      >
        {t('experiments.demo')}
      </h2>
      <div
        class='flex min-h-[220px] items-center justify-center border border-line bg-ink/[0.015] px-6 py-16'
      >
        <Demo />
      </div>
    </section>

    <section
      class='frame-block reveal'
      style='--reveal-delay: 220ms'
      aria-labelledby='code-heading'
    >
      <h2
        id='code-heading'
        class='mb-3 font-mono text-muted text-xs uppercase tracking-[0.18em]'
      >
        {t('experiments.code')}
      </h2>
      <CodeTabs files={exp.files} />
    </section>

    <nav
      class='frame-block reveal'
      style='--reveal-delay: 280ms'
      aria-label='Pagination'
    >
      <div class='flex items-stretch border-line border-t border-l'>
        {
          prev ? (
            <a
              href={`/${lang}/experiments/${prev.slug}`}
              class='flex flex-1 flex-col gap-1 border-line border-r border-b p-4 transition-colors hover:bg-ink/[0.025]'
            >
              <span class='font-mono text-[10px] uppercase tracking-[0.18em] text-muted'>
                ← {t('experiments.prev')}
              </span>
              <span class='text-sm font-medium text-ink'>{prev.title}</span>
            </a>
          ) : (
            <span class='flex-1 border-line border-r border-b' />
          )
        }
        {
          next ? (
            <a
              href={`/${lang}/experiments/${next.slug}`}
              class='flex flex-1 flex-col items-end gap-1 border-line border-r border-b p-4 text-right transition-colors hover:bg-ink/[0.025]'
            >
              <span class='font-mono text-[10px] uppercase tracking-[0.18em] text-muted'>
                {t('experiments.next')} →
              </span>
              <span class='text-sm font-medium text-ink'>{next.title}</span>
            </a>
          ) : (
            <span class='flex-1 border-line border-r border-b' />
          )
        }
      </div>
    </nav>
  </article>
</MainLayout>
