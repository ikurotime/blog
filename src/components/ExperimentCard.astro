---
interface Props {
  title: string
  description: string
  href?: string
  index?: number
}

const { title, description, href, index } = Astro.props as Props
---

<div
  class='group flex h-full w-full flex-col gap-3 border-line border-r border-b p-5 transition-colors hover:bg-ink/[0.025]'
>
  <div class='flex items-center gap-3'>
    {
      index !== undefined && (
        <span class='font-mono text-[10px] text-muted tracking-[0.14em]'>
          {String(index + 1).padStart(2, '0')}
        </span>
      )
    }
    <span class='flex-1 bg-line h-px' aria-hidden='true'></span>
  </div>

  <div
    class='relative z-10 flex min-h-[112px] items-center justify-center px-2 py-6'
  >
    <slot />
  </div>

  <div class='relative z-0 flex flex-col gap-1'>
    {
      href ? (
        <a
          href={href}
          class='flex items-start justify-between gap-3 rounded-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-ink/30'
        >
          <h3 class='text-[15px] font-medium text-ink transition-transform group-hover:translate-x-0.5'>
            {title}
          </h3>
          <svg
            xmlns='http://www.w3.org/2000/svg'
            width='14'
            height='14'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
            class='mt-0.5 shrink-0 text-muted transition-all group-hover:translate-x-0.5 group-hover:text-ink'
            aria-hidden='true'
          >
            <path d='M5 12h14' />
            <path d='m12 5 7 7-7 7' />
          </svg>
        </a>
      ) : (
        <h3 class='text-[15px] font-medium text-ink'>{title}</h3>
      )
    }
    <p class='text-sm text-muted'>{description}</p>
  </div>
</div>
