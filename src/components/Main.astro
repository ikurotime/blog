---
import { getCollection } from 'astro:content'
import Card from '../layouts/Card.astro'
import ProjectCard from './ProjectCard.astro'
import kitmoPreview from '../images/projects/kitmo-preview.jpg'
import tabstashPreview from '../images/projects/tabstash-preview.png'
import kitmoCover from '../images/projects/kitmo.png'
import tabstashCover from '../images/projects/tabstash.png'
import ExperimentCard from './ExperimentCard.astro'
import { experiments } from '../data/experiments'
import ScrambleText from './react/ScrambleText.tsx'
import Status from './Status.astro'
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const years = new Date().getFullYear() - 2020

const allPosts = await getCollection('posts')
const posts = allPosts
  .filter((p) => p.data.draft === false && p.data.language === lang)
  .sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
  )
  .slice(0, 5)

const getPostPath = (page: { slug: string }) => {
  const [pageLang, ...slug] = page.slug.split('/')
  return `/${pageLang}/posts/${slug.join('/') || ''}`
}

const projects = [
  {
    title: 'Kitmo',
    description:
      lang === 'es'
        ? 'Prepara, adapta y programa contenido para tus redes desde un mismo lugar.'
        : 'Prepare, adapt, and schedule content across social channels in one place.',
    cover: kitmoCover,
    preview: kitmoPreview,
    previewAlt:
      lang === 'es'
        ? 'Vista del calendario de publicaciones de Kitmo.'
        : 'Kitmo publishing calendar preview.',
    tags: ['React'],
    href: 'https://kitmo.app'
  },
  {
    title: 'Tabstash',
    description:
      lang === 'es'
        ? 'Organiza enlaces, imágenes y notas en un lienzo infinito.'
        : 'Organize links, images, and notes on an infinite canvas.',
    cover: tabstashCover,
    preview: tabstashPreview,
    previewAlt:
      lang === 'es'
        ? 'Lienzo de Tabstash con enlaces, imágenes, notas y tareas.'
        : 'Tabstash canvas with links, images, notes, and tasks.',
    tags: ['React'],
    href: 'https://tabstash.dev'
  }
]

const socials = [
  { label: 'GitHub', href: 'https://github.com/ikurotime' },
  { label: 'Twitter', href: 'https://twitter.com/ikurotime' },
  { label: 'YouTube', href: 'https://youtube.com/@ikurotime' },
  { label: 'Twitch', href: 'https://twitch.tv/ikurotime' },
  { label: 'Email', href: 'mailto:kuro@maisa.ai' }
]

const bio = t('hero.bio').replace('{years}', String(years))
---

<section
  class='frame-block reveal'
  style='--reveal-delay: 80ms'
  aria-labelledby='hero-heading'
>
  <div class='flex items-center gap-2 font-mono text-muted text-xs'>
    <Status />
    <span class='text-muted/40'>·</span>
    <span>{t('hero.location')}</span>
  </div>

  <h1
    id='hero-heading'
    class='mt-6 font-semibold text-ink text-3xl sm:text-4xl tracking-tight'
  >
    <ScrambleText client:load phrases={['David Huertas', 'Kuro']} />
  </h1>
  <p class='mt-1 font-mono text-muted text-sm'>
    {t('hero.role')}
  </p>

  <p class='mt-6 text-[15px] text-ink/80 leading-7'>
    {bio}
  </p>
</section>

<section
  class='frame-block reveal'
  style='--reveal-delay: 160ms'
  aria-labelledby='projects-heading'
>
  <div class='flex justify-between items-baseline mb-5'>
    <h2
      id='projects-heading'
      class='font-mono text-muted text-xs uppercase tracking-[0.18em]'
    >
      {t('section.projects')}
    </h2>
  </div>
  <ul class='grid grid-cols-1 sm:grid-cols-2 border-line border-t border-l'>
    {
      projects.map((project, i) => (
        <li class='reveal flex' style={`--reveal-delay: ${180 + i * 40}ms`}>
          <ProjectCard
            title={project.title}
            description={project.description}
            tags={project.tags}
            href={project.href}
            cover={project.cover}
            preview={project.preview}
            previewAlt={project.previewAlt}
            previewLabel={lang === 'es' ? 'Ver captura' : 'View screenshot'}
          />
        </li>
      ))
    }
  </ul>
</section>

<section
  class='frame-block reveal'
  style='--reveal-delay: 160ms'
  aria-labelledby='experiments-heading'
>
  <div class='flex flex-col gap-1 mb-5'>
    <h2
      id='experiments-heading'
      class='font-mono text-muted text-xs uppercase tracking-[0.18em]'
    >
      {t('section.experiments')}
    </h2>
    <p class='text-muted text-sm'>{t('section.experiments.desc')}</p>
  </div>
  <ul class='grid grid-cols-1 sm:grid-cols-2 border-line border-t border-l'>
    {
      experiments.map((exp, i) => {
        const Demo = exp.Demo
        return (
          <li class='reveal flex' style={`--reveal-delay: ${200 + i * 40}ms`}>
            <ExperimentCard
              title={exp.title}
              description={exp.description}
              href={`/${lang}/experiments/${exp.slug}`}
              index={i}
            >
              <Demo />
            </ExperimentCard>
          </li>
        )
      })
    }
  </ul>
</section>

{
  posts.length > 0 && (
    <section
      class='frame-block reveal'
      style='--reveal-delay: 180ms'
      aria-labelledby='writing-heading'
    >
      <div class='flex justify-between items-baseline mb-2'>
        <h2
          id='writing-heading'
          class='font-mono text-muted text-xs uppercase tracking-[0.18em]'
        >
          {t('section.writing')}
        </h2>
      </div>
      <ul class='flex flex-col'>
        {posts.map((post) => (
          <li>
            <a
              href={getPostPath(post)}
              class='block rounded-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-ink/30'
            >
              <Card
                title={post.data.title}
                description={post.data.description}
                pubDate={new Date(post.data.pubDate).toLocaleDateString(
                  lang === 'es' ? 'es-ES' : 'en-US',
                  { year: 'numeric', month: 'short', day: 'numeric' }
                )}
              />
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<section
  class='frame-block reveal'
  style='--reveal-delay: 420ms'
  aria-labelledby='connect-heading'
>
  <h2
    id='connect-heading'
    class='mb-4 font-mono text-muted text-xs uppercase tracking-[0.18em]'
  >
    {t('section.connect')}
  </h2>
  <ul class='flex flex-wrap gap-x-5 gap-y-2 text-sm'>
    {
      socials.map((s) => (
        <li>
          <a
            href={s.href}
            target={s.href.startsWith('http') ? '_blank' : undefined}
            rel='noreferrer'
            class='text-ink link-underline'
          >
            {s.label}
            <span class='ml-1 text-muted'>↗</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
